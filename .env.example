# Copy to .env and fill in values — NEVER commit .env to git.

# Polygon EOA private key (hex, no 0x prefix) — Type 0 (EOA) auth
POLY_PRIVATE_KEY=your_private_key_here

# Polymarket proxy wallet address (use if Type 1 / Type 2 auth)
# POLY_FUNDER=0x...

# Polygon chain — mainnet is 137, Amoy testnet is 80002
CHAIN_ID=137

# Binance symbols to subscribe (comma-separated, lowercase)
BINANCE_SYMBOLS=btcusdt

# Risk caps
MAX_NOTIONAL_PER_TRADE=25        # USD per IOC order
MAX_NOTIONAL_PER_MINUTE=200      # USD per rolling 60s window
DAILY_DRAWDOWN_STOP=500          # USD — halt if unrealised + realised loss exceeds this

# Latency / staleness thresholds (seconds)
BINANCE_STALE_SECS=2.0
POLY_STALE_SECS=5.0

# Strategy
EDGE_SAFETY_EPS=0.003            # 30 bps cushion above breakeven
COOLDOWN_SECS=1.0                # per-token fire cooldown

# Paper trade (set to false only after validating paper PnL)
PAPER_TRADE=true
