# Copy to .env and edit. Values shown are the MAX-EV defaults already baked
# into src/config.py — you only need entries here to OVERRIDE them.

# ---- live trading (paper is default; only needed for --live) ----
# POLY_PRIVATE_KEY=0x...
# CHAIN_ID=137

# ---- venue / universe ----
BINANCE_SYMBOLS=btcusdt,ethusdt
MIN_TTE_SECS=60
MAX_TTE_SECS=86400
BOOK_MAX_AGE_SECS=2.0

# ---- sizing / risk ----
MAX_NOTIONAL_PER_TRADE=25
MAX_NOTIONAL_PER_MINUTE=200
DAILY_DRAWDOWN_STOP=500
COOLDOWN_SECS=5.0
BINANCE_STALE_SECS=2.0
POLY_STALE_SECS=5.0

# ---- base edge model ----
EDGE_SAFETY_EPS=0.012
SIGMA_FLOOR=0.40
EFFECTIVE_SPREAD_MULT=1.3
MAX_WALK_SLIPPAGE=0.05
PRICE_MIN=0.10
PRICE_MAX=0.90
SELL_PRICE_MIN=0.03

# ---- favourite-longshot tilt (Portnaya 2026) ----
LONGSHOT_TILT_MULT=1.0
CARRY_FROM_FUNDING=1
SKEW_COEF=0.15

# ---- resolution-source awareness ----
USE_PRICE_TO_BEAT=1
CHAINLINK_BASIS_ADJ=1

# ---- microstructure / OFI / ML ----
OBI_VETO=1
OBI_VETO_THRESHOLD=-0.60
ML_OVERLAY=1
ML_WEIGHT=0.25
MOMENTUM_ENABLED=1
MOMENTUM_MIN_MOVE_USD=60
MOMENTUM_WINDOW_SECS=180
IMPULSE_FADE_ENABLED=1

# ---- mean-reversion overlay ----
MEANREV_ENABLED=1
MEANREV_BAND=0.05
MEANREV_HALF_LIFE_SECS=14400
MEANREV_MAX_HOLD_SECS=12600

# ---- maker execution ----
MAKER_ENABLED=1
MAKER_REBATE_RATE=0.0125
MAKER_JOIN_TICKS=1
MAKER_GTD_SECS=12

# ---- static / combinatorial arb ----
ARB_ENABLED=1
ARB_MIN_CREDIT=0.01
REBALANCE_ARB_ENABLED=1
BUCKET_ARB_ENABLED=1

# ---- cross-venue arb (scan-only unless you wire a Kalshi executor) ----
XVENUE_ENABLED=0
XVENUE_MIN_CREDIT=0.01
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2

# ---- kelly ----
KELLY_ENABLED=1
KELLY_FRACTION=0.30
